# MongoDB. Transactions need a replica set: MongoDB Atlas (free M0, Mumbai region) is one.
# A local standalone mongod does NOT support transactions (see doc/TechStack.md §5.1).
MONGODB_URI="mongodb+srv://b2b_app:change-me@cluster0.xxxxx.mongodb.net/b2b_dev?retryWrites=true&w=majority"
TEST_MONGODB_URI="mongodb+srv://b2b_app:change-me@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

PORT=4000
FRONTEND_URL=http://localhost:3000

# Files: local (dev) | s3 (deployed: Cloudflare R2 / Supabase Storage)
STORAGE_DRIVER=local
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Mail: console (dev, saved in storage/mail) | smtp (deployed: Resend / Brevo)
MAIL_DRIVER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Platform <no-reply@example.com>"

# Auth: any long random string (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=change-me-to-a-long-random-string

# npm run seed creates this Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-12345
